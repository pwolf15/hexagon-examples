#include "AEEStdDef.idl"
#include "remote.idl"

const string IDL_VERSION = "1.0.0";

interface vecadd : remote_handle64 {

  long add_vec(
    in sequence<float> a,
    in sequence<float> b,
    rout sequence<float> result
  );

  long sum_vec_scalar(in sequence<float> a, rout sequence<float> result, rout sequence<long> debug);

  long sum_vec_hvx(in sequence<float> a, rout sequence<float> result, rout sequence<long> debug);

  long sum_vec_hvx_interleaved(in sequence<float> a, rout sequence<float> result, rout sequence<long> debug);

  long mul_vec(
    in sequence<float> a,
    in sequence<float> b,
    rout sequence<float> result
  );

  long dot_vec_scalar(in sequence<uint8> a, in sequence<uint8> b, rout unsigned long result, rout long cycles);
  long dot_vec_hvx(in sequence<uint8> a, in sequence<uint8> b, rout unsigned long result, rout long cycles);

  long get_vtcm(rout unsigned long avail, rout unsigned long max_page, rout unsigned long pages);

};