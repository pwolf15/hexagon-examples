#!/bin/bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
BOARD=${BOARD:?set BOARD, e.g. radxa@192.168.1.50}
DEST=${DEST:-/home/radxa/vecadd}
DSP_ARCH=${DSP_ARCH:-v68}

HOST_SHIP=$ROOT/_ReleaseG_aarch64/ship
DSP_SHIP=$ROOT/hexagon_ReleaseG_toolv19_${DSP_ARCH}/ship

rsync -avz "$HOST_SHIP"/{vecadd_app,vecadd_app_malloc,libvecadd.so} \
           "$DSP_SHIP"/libvecadd_skel.so \
           "$BOARD:$DEST/"

echo "Run on the board: cd $DEST && ./vecadd_app (or set ADSP_LIBRARY_PATH=$DEST to run from elsewhere)"